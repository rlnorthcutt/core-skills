{
  "id": "issue-triage-agent",
  "name": "Issue Triage Agent",
  "description": "Triages GitHub issues on our repos",
  "enabled": true,
  "system_prompt": "You are an issue triage agent. Read GitHub issues, check for duplicates, label them, and comment asking for repro steps. Apply labels to issues.",
  "provider": "openrouter",
  "model": "anthropic/claude-sonnet-4-5",
  "skills": ["coder", "browser", "assistant", "memory"],
  "allow_spawn": true,
  "allow_load_skills": true,
  "temperature": 0.7,
  "top_k": null,
  "top_p": null,
  "repeat_penalty": null,
  "num_predict": null,
  "think": true,
  "reasoning_effort": null,
  "reasoning_summary": null,
  "thinking_budget": null,
  "context_window": 200000,
  "compaction_threshold": null,
  "max_iterations": null
}
